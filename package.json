{
  "name": "bedtime",
  "version": "1.0.0",
  "private": true,
  "description": "A bedtime audiobook player that runs as a Home Screen web app and keeps stories on the phone.",
  "scripts": {
    "serve": "node test/serve.js",
    "build": "npm run compile && node scripts/build-site.js",
    "check": "npm run compile && node scripts/check-ios12.js",
    "test:tags": "node test/tags.test.js",
    "test:browser": "node test/browser.test.js",
    "test:pages": "node test/pages.test.js",
    "test": "npm run check && npm run test:tags && npm run test:artwork && npm run test:browser && npm run test:pages && npm run test:safari",
    "icons": "python3 scripts/make-icons.py",
    "test:artwork": "node test/artwork.test.js",
    "parity": "bash scripts/parity.sh",
    "test:safari": "npm run build && node test/safari.test.js",
    "compile": "tsc -p tsconfig.json && tsc -p tsconfig.sw.json"
  },
  "devDependencies": {
    "@babel/core": "^8.0.5",
    "@babel/preset-env": "^8.0.5",
    "acorn": "^8.18.0",
    "playwright": "^1.49.0",
    "typescript": "^7.0.2"
  }
}
